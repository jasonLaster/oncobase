{
  "name": "@oncobase/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The one place oncobase imports UI SDK from. Each entry re-exports the matching @ui-sdk/react entry.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
