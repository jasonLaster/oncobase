{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "test ! -d apps/app",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun --cwd apps/app scripts/build-vercel.ts",
  "outputDirectory": "apps/app/dist",
  "functions": {
    "api/app-shell.js": {
      "includeFiles": "apps/app/.vercel-functions/**",
      "regions": ["iad1"],
      "maxDuration": 60
    },
    "api/index.js": {
      "includeFiles": "apps/app/.vercel-functions/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/app-shell?__path=$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/integrations/epic/sync",
      "schedule": "0 * * * *"
    }
  ]
}
