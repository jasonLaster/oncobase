diff --git a/apps/app/src/pages/ArticleBody.tsx b/apps/app/src/pages/ArticleBody.tsx
new file mode 100644
index 000000000..eb38ed894
--- /dev/null
+++ b/apps/app/src/pages/ArticleBody.tsx
@@ -0,0 +1,82 @@
+// SPIKE (P3 hydration path): the article's markdown body in its own chunk, so
+// a server-rendered article stays as server HTML (a dehydrated Suspense
+// boundary at OffscreenLane) while the chrome hydrates without the markdown
+// pipeline on its critical path.
+//
+// Long documents render as one Suspense boundary per top-level section, on
+// the server and the client alike. On the client each section waits for its
+// own gate: gates open one at a time, each after the previous section has
+// committed and the page is idle, so every hydration commit is one section's
+// parse and layout instead of all of them in one long task. Known gaps for a
+// real implementation: reference-style links and footnotes defined in another
+// section, and duplicate heading slugs across sections. P12 (parse at publish
+// time) removes the parse altogether.
+import { WikiMarkdown } from "@oncobase/wiki-markdown/browser";
+import { memo, Suspense, use, useEffect, useMemo, type ComponentProps } from "react";
+
+type Props = ComponentProps<typeof WikiMarkdown>;
+const SPLIT_BYTES = 16 * 1024;
+
+export function splitSections(content: string): string[] {
+  if (content.length < SPLIT_BYTES) return [content];
+  const lines = content.split("\n");
+  const sections: string[] = [];
+  let current: string[] = [];
+  let fence: string | null = null;
+  for (const line of lines) {
+    const marker = /^(\s*)(`{3,}|~{3,})/.exec(line)?.[2];
+    if (marker) fence = fence === null ? marker[0]! : (marker[0] === fence ? null : fence);
+    if (fence === null && /^#{1,2} /.test(line) && current.some(l => l.trim())) {
+      sections.push(current.join("\n"));
+      current = [];
+    }
+    current.push(line);
+  }
+  if (current.length) sections.push(current.join("\n"));
+  return sections;
+}
+
+// Sequential hydration gates (client only; the server renders every section).
+let opened = 0;
+const waiting = new Map<number, { promise: Promise<void>; resolve: () => void }>();
+function gateFor(index: number) {
+  if (typeof window === "undefined" || index < opened) return null;
+  let gate = waiting.get(index);
+  if (!gate) {
+    let resolve!: () => void;
+    const promise = new Promise<void>(r => { resolve = r; });
+    gate = { promise, resolve };
+    waiting.set(index, gate);
+  }
+  return gate.promise;
+}
+function openThrough(index: number) {
+  while (opened <= index) { waiting.get(opened)?.resolve(); waiting.delete(opened); opened++; }
+}
+const idle = (callback: () => void) => {
+  const ric = (window as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }).requestIdleCallback;
+  if (ric) ric(callback, { timeout: 300 }); else setTimeout(callback, 16);
+};
+
+const Section = memo(function Section({ index, ...props }: Props & { index: number }) {
+  const gate = gateFor(index);
+  if (gate) use(gate);
+  // This section has committed: let the next one hydrate once the page is idle.
+  useEffect(() => { idle(() => openThrough(index + 1)); }, [index]);
+  return <WikiMarkdown {...props} />;
+});
+
+export default function ArticleBody(props: Props) {
+  const sections = useMemo(() => splitSections(props.content), [props.content]);
+  useEffect(() => { idle(() => openThrough(0)); }, []);
+  if (sections.length <= 1) return <WikiMarkdown {...props} />;
+  return (
+    <div className="wiki-markdown-sections" data-sections={sections.length}>
+      {sections.map((section, index) => (
+        <Suspense key={index} fallback={null}>
+          <Section {...props} index={index} content={section} />
+        </Suspense>
+      ))}
+    </div>
+  );
+}
