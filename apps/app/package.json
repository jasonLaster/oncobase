{
  "name": "@oncobase/app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "bun --cwd ../../packages/smart-table build && bun run typecheck && vite build && bun scripts/build-vercel-functions.ts",
    "check:bundle": "bun scripts/check-bundle-budget.ts",
    "verify:standalone": "bun scripts/verify-standalone.ts",
    "start:server": "bun server/standalone.ts",
    "typecheck": "bun --cwd ../../packages/oncobase build && tsc --noEmit",
    "test:unit": "bun test src server scripts convex/lib",
    "test:e2e": "playwright test",
    "test:e2e:parity": "playwright test --config playwright.parity.config.ts",
    "report:e2e:parity": "bun scripts/compare-parity.ts",
    "test:e2e:endform": "endform test",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "dev:app": "vite --host",
    "dev:convex": "convex dev",
    "lint": "eslint .",
    "wiki:bootstrap": "bun scripts/publish/bootstrap.ts",
    "wiki:vault:starter": "bun scripts/publish/build-vault-starter.ts",
    "wiki:init": "oncobase init",
    "wiki:check": "oncobase check",
    "wiki:publish": "oncobase publish",
    "wiki:sync": "oncobase sync",
    "wiki:skills": "oncobase skills",
    "wiki:site:create": "bun scripts/admin/create-site.ts",
    "wiki:site:token:add": "bun scripts/admin/add-publish-token.ts",
    "wiki:user:password:reset": "bun scripts/admin/reset-user-password.ts",
    "wiki:site:archive": "bun scripts/admin/archive-site.ts",
    "wiki:site:restore": "bun scripts/admin/restore-site.ts",
    "wiki:site:lock-clear": "bun scripts/admin/clear-publish-lock.ts",
    "wiki:site:backfill": "bun scripts/admin/backfill-site-ids.ts",
    "dicom:upload": "bun scripts/upload-dicom-assets.ts",
    "file-asset:upload": "bun scripts/upload-file-asset.ts",
    "dicom-comparisons:seed": "bun scripts/seed-dicom-comparisons.ts",
    "diagnostic-studies:seed": "bun scripts/seed-diagnostic-studies.ts",
    "timeline:seed": "bun scripts/seed-diagnostic-timeline.ts"
  },
  "dependencies": {
    "@liveblocks/client": "^3.18.1",
    "@liveblocks/node": "^3.18.1",
    "@liveblocks/react": "^3.18.1",
    "@liveblocks/react-ui": "^3.18.1",
    "@livestore/adapter-web": "0.3.1",
    "@livestore/livestore": "0.3.1",
    "@livestore/peer-deps": "0.3.1",
    "@livestore/react": "0.3.1",
    "@livestore/wa-sqlite": "1.0.5-dev.2",
    "@oncobase/chat": "workspace:*",
    "@oncobase/diagnostics": "workspace:*",
    "@oncobase/oncobase": "workspace:*",
    "@oncobase/smart-table": "workspace:*",
    "@oncobase/wiki-comments": "workspace:*",
    "@oncobase/wiki-content": "workspace:*",
    "@oncobase/wiki-markdown": "workspace:*",
    "@oncobase/wiki-shell": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.168",
    "archiver": "^7.0.1",
    "convex": "^1.34.1",
    "dotenv": "^17.4.2",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "lucide-react": "^1.11.0",
    "openai": "^6.33.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "7.15.0",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@livestore/devtools-vite": "0.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/archiver": "^7.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.1",
    "axe-core": "4.11.2",
    "bun-types": "^1.3.12",
    "convex-test": "0.0.41",
    "endform": "^0.72.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jszip": "^3.10.1",
    "postcss": "8.5.15",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vite": "8.0.11"
  }
}
