{
  "name": "@oncobase/oncoguide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run content:prepare && next dev -p 62008",
    "content:prepare": "bun scripts/prepare-content.ts",
    "build": "bun run content:prepare && next build && bun scripts/check-export.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "bun test lib/*.test.ts",
    "test:e2e": "playwright test",
    "content:copy": "bun scripts/copy-content.ts"
  },
  "dependencies": {
    "@oncobase/education": "workspace:*",
    "@oncobase/wiki-content": "workspace:*",
    "@oncobase/wiki-markdown": "workspace:*",
    "@oncobase/wiki-shell": "workspace:*",
    "@oncobase/smart-table": "workspace:*",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0"
  }
}
